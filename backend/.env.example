# Backend Environment Variables
# Copy this file to .env and update with your values

# Application Settings
DATABASE_URL=sqlite:///./hackathon.db

# Security
# Generate a strong random key for production (min 32 characters)
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Settings
# AI_PROVIDER options: claude, gemini, qwen
AI_PROVIDER=claude
# Set your API key if using Gemini or other providers
GEMINI_API_KEY=

# AI CLI timeout in seconds
AI_CLI_TIMEOUT=30
# Rate limit for AI requests per minute
AI_RATE_LIMIT_PER_MINUTE=10

# CORS
# URL of the frontend application
FRONTEND_URL=http://localhost:5173

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
